# Optional: override data location
# IAPGUARD_DATA_DIR=./backend/data
# Optional for deployed dashboard (must include scheme/host, without /api)
# VITE_API_URL=http://localhost:8000
# Optional backend process variable for dashboards served from other origins
# IAPGUARD_CORS_ORIGINS=http://localhost:4173
# Optional Vite process variable when the backend listens on a different port
# IAPGUARD_PROXY_TARGET=http://127.0.0.1:8001
